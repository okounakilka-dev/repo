# .gitignore - organized for Freebuff evaluation
# Build outputs - never commit these
bin/
obj/
out/
build/
dist/
*.dll
*.pdb
*.exe
!assets/*.md

# .NET
.vs/
.vscode/
*.user
*.suo
*.userosscache
*.sln.docstates
TestResults/
NuGetFallbackFolder/

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.env
*.egg-info/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Blender
*.blend1
*.blend2
*.blend3
*.blend4
*.blend5
*.blend6
*.blend7
*.blend8
*.blend9

# CAD / generated outputs (keep sources, ignore big renders)
*.dwg
*.bak
generated_images/
*.log

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Secrets - critical for Freebuff / GitHub safety
appsettings.*.json
secrets.json
*.pfx
*.key
*.pem
mod/AISetting*.json
AISetting*.json
.env.local
