<Window x:Class="VPet.AIPlugin.winSetting"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VPet.AIPlugin"
        mc:Ignorable="d"
        Title="AI Assistant Settings" Height="450" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="API Endpoint:" VerticalAlignment="Center" Margin="0,5"/>
        <TextBox x:Name="tbEndpoint" Grid.Row="0" Grid.Column="1" Margin="5,5" Padding="5"
                 ToolTip="e.g., https://api.openai.com/v1/chat/completions or http://localhost:11434/v1/chat/completions"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="API Key:" VerticalAlignment="Center" Margin="0,5"/>
        <PasswordBox x:Name="tbApiKey" Grid.Row="1" Grid.Column="1" Margin="5,5" Padding="5"
                     ToolTip="Leave empty for local models (Ollama, etc.)"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Model:" VerticalAlignment="Center" Margin="0,5"/>
        <ComboBox x:Name="cbModel" Grid.Row="2" Grid.Column="1" Margin="5,5" Padding="5" IsEditable="True">
            <ComboBoxItem Content="gpt-3.5-turbo"/>
            <ComboBoxItem Content="gpt-4"/>
            <ComboBoxItem Content="gpt-4-turbo"/>
            <ComboBoxItem Content="llama3.1"/>
            <ComboBoxItem Content="llama3.2"/>
            <ComboBoxItem Content="mistral"/>
            <ComboBoxItem Content="qwen2.5"/>
            <ComboBoxItem Content="deepseek-chat"/>
        </ComboBox>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Temperature:" VerticalAlignment="Center" Margin="0,5"/>
        <Slider x:Name="slTemperature" Grid.Row="3" Grid.Column="1" Margin="5,5" Minimum="0.1" Maximum="2.0" Value="0.7"
                TickFrequency="0.1" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Max Tokens:" VerticalAlignment="Center" Margin="0,5"/>
        <TextBox x:Name="tbMaxTokens" Grid.Row="4" Grid.Column="1" Margin="5,5" Padding="5" Text="500" Width="100" HorizontalAlignment="Left"/>

        <CheckBox x:Name="cbAutoAction" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="5,10,5,5"
                  Content="Enable Automatic Actions (AI controls pet behavior)"/>

        <TextBlock Grid.Row="6" Grid.Column="0" Text="Action Interval (ticks):" VerticalAlignment="Center" Margin="0,5"/>
        <TextBox x:Name="tbTickInterval" Grid.Row="6" Grid.Column="1" Margin="5,5" Padding="5" Text="30" Width="100" HorizontalAlignment="Left"
                 ToolTip="How often AI decides on an action (1 tick ≈ 1 second)"/>

        <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10">
            <Button x:Name="btnTest" Content="Test Connection" Width="120" Margin="5" Click="BtnTest_Click"/>
            <Button x:Name="btnSave" Content="Save" Width="80" Margin="5" Click="BtnSave_Click"/>
            <Button x:Name="btnCancel" Content="Cancel" Width="80" Margin="5" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>